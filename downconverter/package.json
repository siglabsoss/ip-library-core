{
  "name": "verilator-testbench",
  "version": "0.1.0",
  "description": "Tool to generate verilator testbench",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "header": "echo \"#!/usr/bin/env node\n\" > veritb",
    "templer": "./bin/templer.js --source templates --output lib/templates.js",
    "browserify": "browserify --node src/veritb-src.js >> veritb",
    "chmod": "chmod +x veritb",
    "build": "npm run header && npm run templer && npm run browserify && npm run chmod"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siglabsoss/verilator-testbench.git"
  },
  "author": "",
  "private": true,
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/siglabsoss/verilator-testbench/issues"
  },
  "homepage": "https://github.com/siglabsoss/verilator-testbench#readme",
  "devDependencies": {
    "browserify": "^16.1.0",
    "fs-extra": "^5.0.0",
    "lodash.range": "^3.2.0",
    "lodash.template": "^4.4.0",
    "spawn-sync": "^1.0.15",
    "try-thread-sleep": "^1.0.2",
    "yargs": "^11.0.0"
  }
}
